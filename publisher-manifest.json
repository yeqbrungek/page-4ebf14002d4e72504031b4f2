: 800px) {\n      .hero-split {grid-template-columns: 1fr;gap: 36px;padding: 40px 0}\n      .plan-features-list {grid-template-columns: 1fr}\n      .client-grid {grid-template-columns: 1fr;gap: 20px}\n      .steps-grid {grid-template-columns: 1fr;gap: 20px}\n      .plan-entry {padding: 24px}\n      .plan-top {flex-direction: column;gap: 12px;align-items: flex-start}\n      .plan-price-group {text-align: left}\n    }\n  </style><header class=\"top-bar\">\n    <div class=\"top-bar-inner\">\n      <div class=\"top-bar-brand\">Tblack 规范控制台</div>\n      <nav class=\"top-bar-nav\">\n        <a href=\"#plans\">订阅规格</a>\n        <a href=\"#clients\">接入协议</a>\n        <a href=\"#workflow\">部署指引</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n  </header>\n\n  <main>\n    \n    <section class=\"hero-split\">\n      <div class=\"hero-text\">\n        <h1>Tblack机场(Tblack) 服务参数与配置总览</h1>\n        <p>本文档收录 Tblack 架构下的订阅层级、流量定额、并发连接数及对应运维规约。网络分配遵从既定配额规则，供技术人员与终端用户进行标准化接入参考。</p>\n        <p>所有节点依照基础传输协议进行动态路由调度，请结合所属客户端配置手册完成本地规则下发与调试。</p>\n        <div class=\"hero-meta\">\n          <span>系统状态：在线校验</span>\n          <span>文档版本：2026.04</span>\n          <span>适用范围：公网边缘接入</span>\n        </div>\n      </div>\n      <aside class=\"hero-panel\">\n        <span class=\"panel-header\">网络基准状态</span>\n        <div class=\"panel-metrics\">\n          <div class=\"metric-row\">\n            <span class=\"metric-label\">调度核心</span>\n            <span class=\"metric-val\">v4/v6 双栈自适应</span>\n          </div>\n          <div class=\"metric-row\">\n            <span class=\"metric-label\">连接限制</span>\n            <span class=\"metric-val\">按层级 3 - 20 设备</span>\n          </div>\n          <div class=\"metric-row\">\n            <span class=\"metric-label\">流量计量周期</span>\n            <span class=\"metric-val\">自然月重置 (UTC+8)</span>\n          </div>\n          <div class=\"metric-row\">\n            <span class=\"metric-label\">传输协议支持</span>\n            <span class=\"metric-val\">Shadowsocks / Trojan / VMess</span>\n          </div>\n        </div>\n      </aside>\n    </section>\n\n    \n    <section id=\"plans\">\n      <div class=\"section-head\">\n        <h2>订阅方案与配额规格</h2>\n        <p>各版本提供不同通量的月度数据额度及并发授权，请依照业务实际吞吐需求选择匹配的资源组。</p>\n      </div>\n\n      <div class=\"plan-stack\">\n        \n        <article class=\"plan-entry\">\n          <div class=\"plan-top\">\n            <div class=\"plan-title-area\">\n              <span class=\"plan-name\">基础版</span>\n            </div>\n            <div class=\"plan-price-group\">\n              <div class=\"plan-price-main\">¥15/月</div>\n              <div class=\"plan-price-sub\">按年付仅需 ¥150/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features-list\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        \n        <article class=\"plan-entry plan-entry-featured\">\n          <div class=\"plan-top\">\n            <div class=\"plan-title-area\">\n              <span class=\"plan-name\">旗舰版</span>\n              <span class=\"plan-badge\">标准推荐</span>\n            </div>\n            <div class=\"plan-price-group\">\n              <div class=\"plan-price-main\">¥35/月</div>\n              <div class=\"plan-price-sub\">按年付仅需 ¥350/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features-list\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </article>\n\n        \n        <article class=\"plan-entry\">\n          <div class=\"plan-top\">\n            <div class=\"plan-title-area\">\n              <span class=\"plan-name\">团队版</span>\n            </div>\n            <div class=\"plan-price-group\">\n              <div class=\"plan-price-main\">¥85/月</div>\n              <div class=\"plan-price-sub\">按年付仅需 ¥850/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features-list\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n    </section>\n\n    \n    <section id=\"clients\">\n      <div class=\"section-head\">\n        <h2>客户端接入规格与兼容层</h2>\n        <p>Tblack 本身不分发闭源私有客户端，用户可通过通用开源内核及主流配置工具完成标准订阅拉取。</p>\n      </div>\n      <div class=\"client-spec-block\">\n        <div class=\"client-grid\">\n          <div class=\"client-col\">\n            <h3>桌面端环境 (Desktop)</h3>\n            <p>适用于 Windows、macOS 与 Linux 工作站。支持通过 Clash Verge、Clash Meta 或 v2rayN 等通用客户端载入 YAML 格式的订阅映射配置。</p>\n          </div>\n          <div class=\"client-col\">\n            <h3>移动终端 (Mobile)</h3>\n            <p>适用于 iOS 与 Android 系统。iOS 推荐使用 Shadowrocket、Loon 或 Quantumult X；Android 平台建议通过 Clash Meta for Android 或 sing-box 实施托管更新。</p>\n          </div>\n          <div class=\"client-col\">\n            <h3>网关与路由 (Gateway)</h3>\n            <p>支持部署于 OpenWrt、软路由及嵌入式网络设备。依托透明代理组件完成局域网分流，请确保内网设备并发数不超出方案设定的硬件上限。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"workflow\">\n      <div class=\"section-head\">\n        <h2>标准接入作业步骤</h2>\n        <p>请按下列技术规程顺序执行节点配置与路由验证。</p>\n      </div>\n      <div class=\"steps-container\">\n        <div class=\"steps-grid\">\n          <div class=\"step-item\">\n            <span class=\"step-num\">STEP 01</span>\n            <div class=\"step-title\">获取订阅源串</div>\n            <div class=\"step-desc\">确认账户有效性并导出对应协议的 URI 链接，避免直接暴露包含密钥的明文地址。</div>\n          </div>\n          <div class=\"step-item\">\n            <span class=\"step-num\">STEP 02</span>\n            <div class=\"step-title\">解析配置载荷</div>\n            <div class=\"step-desc\">在客户端内添加托管链接，同步节点列表与分流规程，完成证书链及端口校正。</div>\n          </div>\n          <div class=\"step-item\">\n            <span class=\"step-num\">STEP 03</span>\n            <div class=\"step-title\">确立路由策略</div>\n            <div class=\"step-desc\">按需切换为规则分流（Rule-based）或全局模式，防止局域网内地址被非预期转发。</div>\n          </div>\n          <div class=\"step-item\">\n            <span class=\"step-num\">STEP 04</span>\n            <div class=\"step-title\">联通性测试</div>\n            <div class=\"step-desc\">执行 ICMP/TCP 延迟探测与 DNS 泄漏检测，验证通道建立状态是否符合运行指标。</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"faq\">\n      <div class=\"section-head\">\n        <h2>常见问题解答</h2>\n        <p>关于流量核算、节点连通故障及多终端限制的运维备忘。</p>\n      </div>\n      <div class=\"faq-wrapper\">\n        <details class=\"faq-item\">\n          <summary>月度流量的重置机制与计费周期如何界定？</summary>\n          <p>所有订阅层级的流量额度均按订购日起算或固定自然月区间计算（以系统控制台实际账单周期为准）。在对应周期结束前未消耗完毕的数据量将自动失效，不予结转至次月。</p>\n        </details>\n        <details class=\"faq-item\">\n          <summary>超出方案限制的最大在线设备数会产生何种结果？</summary>\n          <p>服务端依据并发 IP 建立的会话连接数进行动态限流。当在线终端超过规格上限（例如基础版超过 3 台），后接入的设备将触发握手超时错误，直到既有连接释放。</p>\n        </details>\n        <details class=\"faq-item\">\n          <summary>节点出现大范围握手失败或无法连接时如何自检？</summary>\n          <p>首先请检查客户端本地系统时间是否与标准网络时间同步，时间误差超过 60 秒会导致部分加密传输握手失败。其次可尝试重新拉取最新订阅地址以刷新节点端口及动态解析记录。</p>\n        </details>\n        <details class=\"faq-item\">\n          <summary>如何选择中继节点以满足低延迟交互需求？</summary>\n          <p>旗舰版与团队版提供优化的 IPLC 专线路由，规避公网波动影响。在客户端策略组中选择标有专线标识的分组，并关闭可能导致回环的重复加密配置。</p>\n        </details>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div>\n      <div>Tblack 网络工程参考规范</div>\n      <div>严谨配置 · 规范接入 · 持续服务</div>\n    </div>\n  </footer>",
